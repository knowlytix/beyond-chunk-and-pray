# RAG notebook configuration — copy to `.env` and fill in. `.env` is gitignored.
# Auto-loaded by book_kit.py. Shell exports override the file.

# ── Licensed GMS backend (the RAG chapter notebooks are GMS-native) ──
KNOWLYTIX_LICENSE_KEY=
# KNOWLYTIX_INDEX_URL=            # private index, for `pip install knowlytix`
# KNOWLYTIX_SRC=                  # only for a source checkout of knowlytix (blank if pip-installed)

# ── Paths (defaults are usually fine) ──
# GMS_RAG_TUTORIAL=               # repo root (default: auto)
# GMS_RAG_STORE=                  # trained store (default: data/gms_annual_report_store)

# ── Optional run toggles ──
# GMS_RUN_GPU=0
# GMS_RUN_QWEN=0
